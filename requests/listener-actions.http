### Run this first. The HTTP client keeps the XSRF-TOKEN cookie and saves the header value for unsafe requests.
GET http://localhost:8080/api/auth/csrf
> {% client.global.set("csrfHeader", response.body.headerName); client.global.set("csrfToken", response.body.token); %}

### Login with a seed user. The response creates a server session cookie.
POST http://localhost:8080/api/auth/login
Content-Type: application/json
{{csrfHeader}}: {{csrfToken}}

{
  "username": "musiclover42",
  "password": "password123"
}

### Get current listener state for a song
GET http://localhost:8080/api/listener/me/songs/1

### Stream a song
POST http://localhost:8080/api/listener/me/songs/1/stream
{{csrfHeader}}: {{csrfToken}}

### Skip a song
POST http://localhost:8080/api/listener/me/songs/1/skip
{{csrfHeader}}: {{csrfToken}}

### Like a song
PUT http://localhost:8080/api/listener/me/songs/1/attitude
Content-Type: application/json
{{csrfHeader}}: {{csrfToken}}

{
  "attitude": "like"
}

### Dislike a song
PUT http://localhost:8080/api/listener/me/songs/1/attitude
Content-Type: application/json
{{csrfHeader}}: {{csrfToken}}

{
  "attitude": "dislike"
}

### Mark a song not interested
PUT http://localhost:8080/api/listener/me/songs/1/attitude
Content-Type: application/json
{{csrfHeader}}: {{csrfToken}}

{
  "attitude": "not_interested"
}

### Clear song attitude
DELETE http://localhost:8080/api/listener/me/songs/1/attitude
{{csrfHeader}}: {{csrfToken}}

### Block a song
PUT http://localhost:8080/api/listener/me/songs/11/block
{{csrfHeader}}: {{csrfToken}}

### Unblock a song
DELETE http://localhost:8080/api/listener/me/songs/11/block
{{csrfHeader}}: {{csrfToken}}

### Get listening history
GET http://localhost:8080/api/listener/me/history?page=0&size=20

### Clear listener's history
DELETE http://localhost:8080/api/listener/me/history
{{csrfHeader}}: {{csrfToken}}

### Get current listener state for a performer
GET http://localhost:8080/api/listener/me/performers/1

### Follow a performer
PUT http://localhost:8080/api/listener/me/performers/1/follow
{{csrfHeader}}: {{csrfToken}}

### Unfollow a performer
DELETE http://localhost:8080/api/listener/me/performers/1/follow
{{csrfHeader}}: {{csrfToken}}

### Like a performer
PUT http://localhost:8080/api/listener/me/performers/1/attitude
Content-Type: application/json
{{csrfHeader}}: {{csrfToken}}

{
  "attitude": "like"
}

### Dislike a performer
PUT http://localhost:8080/api/listener/me/performers/1/attitude
Content-Type: application/json
{{csrfHeader}}: {{csrfToken}}

{
  "attitude": "dislike"
}

### Clear performer attitude
DELETE http://localhost:8080/api/listener/me/performers/1/attitude
{{csrfHeader}}: {{csrfToken}}

### Block a performer
PUT http://localhost:8080/api/listener/me/performers/4/block
